  {
    "id": "table_leituras",
    "type": "ui_table",
    "z": "tab_petpulse",
    "name": "Últimas Leituras",
    "group": "grp_historico",
    "order": 2,
    "width": 12,
    "height": 5,
    "outputs": 0,
    "cts": false,
    "title": "📋 Últimas Leituras",
    "columns": [
      { "field": "bpm",       "title": "BPM",        "width": "80px",  "align": "center", "format": "" },
      { "field": "atividade", "title": "Atividade",  "width": "120px", "align": "center", "format": "" },
      { "field": "pressao",   "title": "Pressão",    "width": "100px", "align": "center", "format": "" },
      { "field": "hora",      "title": "Horário",    "width": "100px", "align": "center", "format": "" }
    ],
    "x": 850,
    "y": 240,
